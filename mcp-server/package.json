{
  "name": "mcp-server",
  "version": "0.1.0",
  "private": true,
  "description": "Read-only MCP server that serves a curated developer profile to the opisuomea.org recruiter chatbot.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build:index": "tsx scripts/build-index.ts",
    "dev": "tsx src/localDevServer.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\" \"scripts/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"test/**/*.ts\" \"scripts/**/*.ts\""
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.3.1",
    "yaml": "^2.9.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.164",
    "@types/node": "^24.19.2",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "~6.0.2",
    "vitest": "^4.1.12"
  }
}
