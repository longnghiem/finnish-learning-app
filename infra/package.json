{
  "name": "infra",
  "version": "0.1.0",
  "private": true,
  "description": "AWS CDK app for the opisuomea.org recruiter chatbot's AWS resources.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "cdk": "cdk",
    "synth": "cdk synth",
    "diff": "cdk diff",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"bin/**/*.ts\" \"lib/**/*.ts\" \"test/**/*.ts\"",
    "format:check": "prettier --check \"bin/**/*.ts\" \"lib/**/*.ts\" \"test/**/*.ts\""
  },
  "dependencies": {
    "aws-cdk-lib": "^2.273.0",
    "constructs": "^10.8.1"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "aws-cdk": "^2.1146.0",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "~6.0.2",
    "vitest": "^4.1.12"
  }
}